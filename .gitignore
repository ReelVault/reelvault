# ==================== #
# EDITOR
# ==================== #

# Keep shared VS Code config in git (launch.json, settings.json,
# extensions.json); ignore everything else under .vscode/ (local overrides,
# workspace-specific caches).
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ==================== #
# GENERATED
# ==================== #

src/paraglide/
**/routeTree.gen.ts
**/*.gen.ts

