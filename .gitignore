# ==================== #

.agents/
.VSCodeCounter
repomix-output*

# ==================== #
# PROJECT SPECIFIC
# ==================== #
.zcode
.zcodeignore

# Default ROOT_DIR for bare launches (./data) and its generated secrets
/data
secrets.env

# SDK package license, copied from the repo root by `prepack`
sdk/LICENSE
sdk/*.tgz
# Scenario runner artifacts (bun run scenarios)
/benchmark-results
