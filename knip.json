{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"workspaces": {
		".": {
			"entry": ["tests/**/*.test.ts", "scripts/**/*.script.ts", "scripts/benchmarks/*.bench.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
		},
		"packages/benchkit": {
			"entry": ["src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		}
	},
	"ignoreDependencies": [],
	"ignoreBinaries": ["ffmpeg"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "error",
		"types": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"namespaceMembers": "error",
		"cycles": "error"
	}
}
