{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": ["tests/**/*.test.ts", "scripts/**/*.ts", "packages/benchkit/**/*.test.ts"],
	"project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"],
	"ignoreDependencies": [],
	"ignoreBinaries": ["ffmpeg", "check"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"exports": "error",
		"types": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"namespaceMembers": "error",
		"cycles": "error"
	}
}
