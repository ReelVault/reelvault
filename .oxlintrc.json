{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "promise", "import", "node", "vitest"],
	"options": {
		"typeAware": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"restriction": "off",
		"style": "off",
		"pedantic": "off",
		"nursery": "off"
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": ["dist", "build", "node_modules", ".agents", "**/routeTree.gen.ts", "**/*.gen.ts"],
	"rules": {
		"typescript/no-namespace": "error",
		"typescript/no-for-in-array": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-unsafe-type-assertion": "error",
		"typescript/prefer-regexp-exec": "error",
		"typescript/use-unknown-in-catch-callback-variable": "error",
		"typescript/no-non-null-asserted-optional-chain": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/ban-ts-comment": [
			"error",
			{
				"ts-expect-error": false,
				"ts-ignore": true,
				"ts-nocheck": true,
				"ts-check": false
			}
		],
		"typescript/consistent-type-assertions": [
			"error",
			{
				"assertionStyle": "as",
				"objectLiteralTypeAssertions": "never"
			}
		],
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/no-unsafe-declaration-merging": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-floating-promises": "error",
		"typescript/require-await": "error",
		"typescript/await-thenable": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-mixed-enums": "error",
		"typescript/no-duplicate-enum-values": "error",
		"typescript/no-import-type-side-effects": "error",
		"typescript/consistent-indexed-object-style": ["error", "record"],
		"typescript/array-type": [
			"error",
			{
				"default": "array-simple"
			}
		],
		"typescript/no-empty-object-type": "error",
		"typescript/no-wrapper-object-types": "error",
		"typescript/no-extraneous-class": "error",
		"typescript/no-useless-empty-export": "error",
		"typescript/no-unnecessary-condition": "error",
		"typescript/no-unnecessary-type-parameters": "error",
		"typescript/no-confusing-non-null-assertion": "error",
		"typescript/no-dynamic-delete": "error",
		"typescript/prefer-as-const": "error",
		"typescript/no-inferrable-types": "error",
		"typescript/prefer-optional-chain": "error",
		"typescript/prefer-nullish-coalescing": "error",
		"typescript/prefer-readonly": "error",
		"typescript/prefer-find": "error",
		"typescript/prefer-string-starts-ends-with": "error",
		"typescript/prefer-reduce-type-parameter": "error",
		"typescript/prefer-return-this-type": "error",
		"typescript/prefer-literal-enum-member": "error",
		"typescript/promise-function-async": "off",
		"typescript/return-await": "off",
		"typescript/restrict-template-expressions": [
			"error",
			{
				"allowNumber": true,
				"allowBoolean": true,
				"allowNullish": false
			}
		],
		"typescript/restrict-plus-operands": "error",
		"typescript/unbound-method": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-array-delete": "error",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-this-alias": "error",
		"typescript/only-throw-error": "error",
		"typescript/related-getter-setter-pairs": "error",
		"typescript/no-unnecessary-boolean-literal-compare": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/no-unnecessary-type-arguments": "error",
		"typescript/no-unnecessary-type-conversion": "error",
		"typescript/no-deprecated": "error",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/require-array-sort-compare": "error",
		"eslint/preserve-caught-error": "error",
		"eslint/no-warning-comments": "error",
		"eslint/no-new-wrappers": "error",
		"eslint/no-empty-function": "error",
		"eslint/operator-assignment": "error",
		"eslint/prefer-const": "error",
		"eslint/no-shadow": "error",
		"eslint/no-duplicate-imports": "error",
		"eslint/no-lonely-if": "error",
		"eslint/no-nested-ternary": "error",
		"eslint/no-else-return": "error",
		"eslint/no-unneeded-ternary": "error",
		"eslint/no-useless-return": "error",
		"eslint/no-negated-condition": "error",
		"eslint/no-implicit-coercion": "error",
		"eslint/max-depth": [
			"error",
			{
				"max": 4
			}
		],
		"import/no-unassigned-import": "error",
		"typescript/consistent-return": "error",
		"eslint/require-await": "off",
		"eslint/default-case-last": "error",
		"eslint/no-promise-executor-return": "error",
		"eslint/no-await-in-loop": "off",
		"eslint/no-underscore-dangle": "off",
		"eslint/array-callback-return": "error",
		"eslint/no-constant-condition": "error",
		"eslint/no-unused-vars": "off",
		"eslint/no-use-before-define": [
			"error",
			{
				"functions": false
			}
		],
		"eslint/no-new-func": "error",
		"eslint/no-script-url": "error",
		"eslint/no-return-assign": "error",
		"eslint/no-sequences": "error",
		"eslint/no-template-curly-in-string": "error",
		"eslint/no-object-constructor": "error",
		"unicorn/custom-error-definition": "error",
		"unicorn/no-useless-error-capture-stack-trace": "error",
		"unicorn/no-useless-fallback-in-spread": "error",
		"unicorn/consistent-existence-index-check": "error",
		"unicorn/no-null": "off",
		"unicorn/filename-case": "off",
		"unicorn/no-array-for-each": "error",
		"unicorn/no-negated-condition": "off",
		"unicorn/no-useless-undefined": "error",
		"unicorn/no-array-reduce": "error",
		"unicorn/no-nested-ternary": "off",
		"unicorn/prefer-top-level-await": "off",
		"unicorn/throw-new-error": "error",
		"unicorn/error-message": "error",
		"unicorn/prefer-optional-catch-binding": "error",
		"unicorn/no-instanceof-array": "error",
		"unicorn/no-instanceof-builtins": "error",
		"unicorn/no-new-array": "error",
		"unicorn/no-thenable": "error",
		"unicorn/prefer-array-flat-map": "error",
		"unicorn/prefer-string-slice": "error",
		"unicorn/prefer-spread": "error",
		"unicorn/prefer-number-properties": "error",
		"unicorn/prefer-date-now": "error",
		"unicorn/prefer-regexp-test": "error",
		"unicorn/prefer-string-replace-all": "error",
		"unicorn/prefer-string-raw": "error",
		"unicorn/prefer-array-some": "error",
		"unicorn/prefer-set-has": "error",
		"unicorn/prefer-structured-clone": "error",
		"unicorn/prefer-logical-operator-over-ternary": "error",
		"unicorn/consistent-function-scoping": "error",
		"unicorn/no-object-as-default-parameter": "error",
		"unicorn/no-unreadable-array-destructuring": "off",
		"unicorn/require-array-join-separator": "error",
		"unicorn/switch-case-braces": ["error", "avoid"],
		"unicorn/no-useless-promise-resolve-reject": "error",
		"unicorn/no-unnecessary-await": "error",
		"unicorn/no-single-promise-in-promise-methods": "error",
		"unicorn/no-await-in-promise-methods": "error",
		"unicorn/no-array-callback-reference": "error",
		"unicorn/catch-error-name": "error",
		"unicorn/consistent-assert": "error",
		"unicorn/no-process-exit": "off",
		"unicorn/prefer-node-protocol": "error",
		"unicorn/no-lonely-if": "off",
		"unicorn/prefer-add-event-listener": "error",
		"unicorn/no-invalid-remove-event-listener": "error",
		"unicorn/no-unreadable-iife": "error",
		"unicorn/require-post-message-target-origin": "error",
		"unicorn/prefer-modern-math-apis": "error",
		"unicorn/no-typeof-undefined": "error",
		"promise/param-names": "error",
		"promise/no-return-wrap": "error",
		"promise/always-return": "off",
		"promise/no-nesting": "error",
		"promise/prefer-await-to-then": "error",
		"promise/no-promise-in-callback": "off",
		"promise/no-new-statics": "error",
		"promise/valid-params": "error",
		"promise/no-callback-in-promise": "warn",
		"import/no-commonjs": "error",
		"import/no-cycle": "error",
		"import/no-self-import": "error",
		"import/no-duplicates": "error",
		"import/no-default-export": "error",
		"import/first": "error",
		"import/no-empty-named-blocks": "error",
		"import/no-named-as-default-member": "error",
		"import/no-mutable-exports": "error",
		"import/no-relative-parent-imports": "error",
		"node/no-process-env": "error",
		"node/no-path-concat": "error",
		"eslint/eqeqeq": "error",
		"vitest/no-focused-tests": "error",
		"vitest/no-disabled-tests": "error",
		"vitest/expect-expect": "error",
		"vitest/valid-expect-in-promise": "error",
		"vitest/prefer-each": "error"
	},
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "tests/**"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/require-await": "off",
				"typescript/promise-function-async": "off",
				"typescript/return-await": "off",
				"typescript/no-unnecessary-condition": "off",
				"typescript/restrict-template-expressions": "off",
				"typescript/no-unnecessary-type-conversion": "off",
				"typescript/no-unnecessary-type-arguments": "off",
				"typescript/await-thenable": "off",
				"typescript/unbound-method": "off",
				"unicorn/consistent-function-scoping": "off",
				"unicorn/no-useless-undefined": "off",
				"unicorn/no-array-callback-reference": "off",
				"eslint/no-shadow": "off",
				"promise/prefer-await-to-then": "off",
				"import/no-relative-parent-imports": "off"
			}
		},
		{
			"files": ["**/*.config.ts", "**/*.config.js", "vite.config.ts"],
			"rules": {
				"import/no-default-export": "off"
			}
		},
		{
			"files": ["src/**/*.ts", "!src/**/*.test.ts", "!src/**/*.spec.ts"],
			"rules": {
				"import/no-named-as-default": "off",
				"import/no-named-as-default-member": "off"
			}
		},
		{
			"files": ["src/config/version.constants.ts"],
			"rules": {
				"import/no-relative-parent-imports": "off"
			}
		},
		{
			"files": ["src/config/env.config.ts", "scripts/**", "packages/benchkit/**", "tests/**"],
			"rules": {
				"node/no-process-env": "off"
			}
		}
	]
}
