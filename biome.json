{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.agents", "!dist", "!build", "!**/*.svg", "!**/routeTree.gen.ts", "!**/*.gen.ts"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140,
		"lineEnding": "lf",
		"formatWithErrors": false
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "always",
			"trailingCommas": "all",
			"semicolons": "always",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"test": "recommended",
			"drizzle": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessStringConcat": "error",
				"noUselessUndefinedInitialization": "error",
				"noVoid": "error",
				"useDateNow": "error",
				"noImportantStyles": "off",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 25
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 100
					}
				},
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 5
					}
				},
				"noExcessiveNestedTestSuites": "warn",
				"noForEach": "off",
				"useSimplifiedLogicExpression": "error",
				"noUselessTernary": "error",
				"noUselessTypeConstraint": "error",
				"noUselessSwitchCase": "error",
				"noUselessLoneBlockStatements": "error",
				"noAdjacentSpacesInRegex": "error"
			},
			"correctness": {
				"noConstantMathMinMaxClamp": "error",
				"noUndeclaredVariables": "error",
				"noUnusedImports": {
					"fix": "safe",
					"level": "error"
				},
				"noUnusedFunctionParameters": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"noUnreachable": "error",
				"noUnreachableSuper": "error",
				"useIsNan": "error",
				"useValidTypeof": "error",
				"noInvalidConstructorSuper": "error",
				"noInvalidUseBeforeDeclaration": "error",
				"noSelfAssign": "error",
				"noSwitchDeclarations": "error",
				"noVoidTypeReturn": "error",
				"noConstAssign": "error",
				"noPrecisionLoss": "error",
				"noSetterReturn": "error",
				"noGlobalObjectCalls": "error"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noBarrelFile": "warn",
				"noReExportAll": "warn",
				"noNamespaceImport": "warn",
				"useTopLevelRegex": "error",
				"noDelete": "error",
				"noDynamicNamespaceImportAccess": "error"
			},
			"style": {
				"noParameterProperties": "error",
				"noYodaExpression": "error",
				"useConsistentBuiltinInstantiation": "error",
				"useShorthandAssign": "error",
				"useArrayLiterals": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useThrowOnlyError": "error",
				"useThrowNewError": "error",
				"useNodejsImportProtocol": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "interface"
					}
				},
				"noDefaultExport": "off",
				"noMagicNumbers": "off",
				"useNamingConvention": "off",
				"useSingleVarDeclarator": "error",
				"useConst": "error",
				"useDefaultSwitchClause": "warn",
				"useNumberNamespace": "error",
				"useTemplate": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error",
				"useExplicitLengthCheck": "error",
				"useDefaultParameterLast": "error",
				"noRestrictedTypes": {
					"level": "error",
					"options": {
						"types": {
							"object": "Use a specific interface or 'Record<string, unknown>' instead.",
							"Function": "Use a specific function signature instead."
						}
					}
				}
			},
			"suspicious": {
				"useAwait": "error",
				"noEvolvingTypes": "error",
				"noDeprecatedImports": "error",
				"noExplicitAny": "off",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["warn", "error"]
					}
				},
				"noConstantBinaryExpressions": "error",
				"noDoubleEquals": "error",
				"noConfusingVoidType": "error",
				"noAssignInExpressions": "error",
				"noAsyncPromiseExecutor": "error",
				"noCatchAssign": "error",
				"noCommentText": "error",
				"noCompareNegZero": "error",
				"noControlCharactersInRegex": "error",
				"noDebugger": "error",
				"noDuplicateCase": "error",
				"noDuplicateClassMembers": "error",
				"noDuplicateObjectKeys": "error",
				"noDuplicateParameters": "error",
				"noEmptyBlockStatements": "warn",
				"noFallthroughSwitchClause": "error",
				"noFunctionAssign": "error",
				"noGlobalAssign": "error",
				"noImportAssign": "error",
				"noLabelVar": "error",
				"noMisleadingCharacterClass": "error",
				"noMisleadingInstantiator": "error",
				"noPrototypeBuiltins": "error",
				"noSelfCompare": "error",
				"noShadowRestrictedNames": "error",
				"noSparseArray": "error",
				"noThenProperty": "error",
				"noUnsafeDeclarationMerging": "error",
				"noUnsafeNegation": "error",
				"useAdjacentOverloadSignatures": "error",
				"useErrorMessage": "error",
				"useGetterReturn": "error",
				"useNamespaceKeyword": "error",
				"useNumberToFixedDigitsArgument": "error",
				"noVar": "error",
				"noWith": "error",
				"noOctalEscape": "error"
			},
			"nursery": {
				"noFloatingPromises": "off",
				"noMisusedPromises": "off",
				"useAwaitThenable": "off",
				"noUnsafeTypeAssertion": "off",
				"noUselessTypeConversion": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUnsafePlusOperands": "off",
				"noBaseToString": "off",
				"noMisleadingReturnType": "error",
				"noImpliedEval": "error",
				"noExtendNative": "error",
				"noLoopFunc": "error",
				"noUnmodifiedLoopCondition": "error",
				"useExhaustiveSwitchCases": "error",
				"useArraySome": "error",
				"useIncludes": "error",
				"noDrizzleDeleteWithoutWhere": "error",
				"noDrizzleUpdateWithoutWhere": "error",
				"noThisOutsideOfClass": "error",
				"noNegationInEqualityCheck": "error",
				"noEmptyObjectKeys": "error",
				"noExcessiveNestedCallbacks": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["tests/sdk/common-barrel.test.ts"],
			"linter": {
				"rules": {
					"performance": {
						"noNamespaceImport": "off"
					}
				}
			}
		},
		{
			"includes": ["sdk/**"],
			"linter": {
				"rules": {
					"performance": {
						"noReExportAll": "off",
						"noBarrelFile": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"nursery": {
						"noUnsafeTypeAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.ts", "**/*.config.js"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["src/database/schema.ts"],
			"linter": {
				"rules": {
					"performance": {
						"noNamespaceImport": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/benchkit/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"performance": {
						"noReExportAll": "off",
						"noBarrelFile": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
