{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!.agents", "!dist", "!build", "!**/*.svg", "!**/routeTree.gen.ts", "!**/*.gen.ts"]
	},
	"plugins": [
		{
			"path": "./scripts/lint/long-ternary.grit",
			"includes": ["**/src/**", "!**/packages/**", "!**/src/**/*.test.ts", "!**/src/**/*.spec.ts"]
		},
		{
			"path": "./scripts/lint/else-if-chain.grit",
			"includes": ["**/src/**", "!**/packages/**", "!**/src/**/*.test.ts", "!**/src/**/*.spec.ts"]
		},
		{
			"path": "./scripts/lint/no-namespace-object.grit",
			"includes": ["**/src/**", "!**/packages/**", "!**/src/**/*.test.ts", "!**/src/**/*.spec.ts"]
		},
		{
			"path": "./scripts/lint/no-todo-test.grit",
			"includes": ["**/src/**", "!**/packages/**"]
		},
		{
			"path": "./scripts/lint/no-lost-error-cause.grit",
			"includes": ["**/src/**", "!**/packages/**"]
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140,
		"lineEnding": "lf",
		"formatWithErrors": false
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "always",
			"trailingCommas": "all",
			"semicolons": "always",
			"bracketSpacing": true
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"test": "recommended",
			"drizzle": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessStringConcat": "error",
				"noUselessUndefinedInitialization": "error",
				"noVoid": "error",
				"useDateNow": "error",
				"noImportantStyles": "off",
				"noImplicitCoercions": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 100
					}
				},
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 5
					}
				},
				"noExcessiveNestedTestSuites": "error",
				"noForEach": "error",
				"useSimplifiedLogicExpression": "error",
				"noUselessTernary": "error",
				"noUselessTypeConstraint": "error",
				"noUselessSwitchCase": "error",
				"noUselessLoneBlockStatements": "error",
				"noAdjacentSpacesInRegex": "error",
				"useLiteralKeys": "error",
				"useIndexOf": "error",
				"useOptionalChain": "error",
				"useFlatMap": "error",
				"noCommaOperator": "error",
				"noStaticOnlyClass": "error",
				"noThisInStatic": "error",
				"noUselessCatchBinding": "error",
				"noUnnecessaryTemplateExpression": "error",
				"useArraySome": "error",
				"noExcessiveNestedCallbacks": "warn"
			},
			"correctness": {
				"noConstantMathMinMaxClamp": "error",
				"noUndeclaredVariables": "error",
				"noUnusedImports": {
					"fix": "safe",
					"level": "error"
				},
				"noUnusedFunctionParameters": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"noUnreachable": "error",
				"noUnreachableSuper": "error",
				"useIsNan": "error",
				"useValidTypeof": "error",
				"noInvalidConstructorSuper": "error",
				"noInvalidUseBeforeDeclaration": "error",
				"noSelfAssign": "error",
				"noSwitchDeclarations": "error",
				"noVoidTypeReturn": "error",
				"noConstAssign": "error",
				"noPrecisionLoss": "error",
				"noSetterReturn": "error",
				"noGlobalObjectCalls": "error",
				"noUnsafeFinally": "error",
				"noDuplicateVariableNames": "error"
			},
			"security": {
				"noGlobalEval": "error",
				"noSecrets": "off"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noBarrelFile": "error",
				"noReExportAll": "error",
				"noNamespaceImport": "error",
				"useTopLevelRegex": "error",
				"noDelete": "error",
				"noDynamicNamespaceImportAccess": "error"
			},
			"style": {
				"noParameterProperties": "error",
				"noYodaExpression": "error",
				"useConsistentBuiltinInstantiation": "error",
				"useShorthandAssign": "error",
				"useArrayLiterals": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useThrowOnlyError": "error",
				"useThrowNewError": "error",
				"useNodejsImportProtocol": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "interface"
					}
				},
				"noDefaultExport": "error",
				"noMagicNumbers": "off",
				"useNamingConvention": "off",
				"useTrimStartEnd": "error",
				"useEnumInitializers": "error",
				"useLiteralEnumMembers": "error",
				"useGlobalThis": "error",
				"useErrorCause": "off",
				"useConsistentArrayType": "off",
				"noExcessiveClassesPerFile": {
					"level": "error",
					"options": {
						"maxClasses": 2
					}
				},
				"useSingleVarDeclarator": "error",
				"useConst": "error",
				"useDefaultSwitchClause": "error",
				"useNumberNamespace": "error",
				"useTemplate": "error",
				"useAtIndex": "error",
				"useForOf": "error",
				"noUnusedTemplateLiteral": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error",
				"noNestedTernary": "error",
				"useCollapsedElseIf": "error",
				"useCollapsedIf": "error",
				"useExponentiationOperator": "error",
				"useExplicitLengthCheck": "error",
				"useDefaultParameterLast": "error",
				"noRestrictedTypes": {
					"level": "error",
					"options": {
						"types": {
							"object": "Use a specific interface or 'Record<string, unknown>' instead.",
							"Function": "Use a specific function signature instead."
						}
					}
				}
			},
			"suspicious": {
				"useAwait": "error",
				"noEvolvingTypes": "error",
				"noDeprecatedImports": "error",
				"noExplicitAny": "off",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["warn", "error"]
					}
				},
				"noConstantBinaryExpressions": "error",
				"noDoubleEquals": "error",
				"noConfusingVoidType": "error",
				"noAssignInExpressions": "error",
				"noAsyncPromiseExecutor": "error",
				"noCatchAssign": "error",
				"noCommentText": "error",
				"noCompareNegZero": "error",
				"noControlCharactersInRegex": "error",
				"noDebugger": "error",
				"noDuplicateCase": "error",
				"noDuplicateClassMembers": "error",
				"noDuplicateObjectKeys": "error",
				"noDuplicateParameters": "error",
				"noEmptyBlockStatements": "error",
				"noFallthroughSwitchClause": "error",
				"noFunctionAssign": "error",
				"noGlobalAssign": "error",
				"noImportAssign": "error",
				"noLabelVar": "error",
				"noMisleadingCharacterClass": "error",
				"noMisleadingInstantiator": "error",
				"noPrototypeBuiltins": "error",
				"noSelfCompare": "error",
				"noShadowRestrictedNames": "error",
				"noSparseArray": "error",
				"noThenProperty": "error",
				"noUnsafeDeclarationMerging": "error",
				"noUnsafeNegation": "error",
				"useAdjacentOverloadSignatures": "error",
				"useErrorMessage": "error",
				"useGetterReturn": "error",
				"useNamespaceKeyword": "error",
				"useNumberToFixedDigitsArgument": "error",
				"noVar": "error",
				"noWith": "error",
				"noOctalEscape": "error",
				"noSkippedTests": "error",
				"noFocusedTests": "error",
				"noDuplicateElseIf": "error",
				"noUnassignedVariables": "error",
				"noDuplicateTestHooks": "error",
				"noEmptyInterface": "error",
				"noDuplicateEnumValues": "error",
				"noEqualsToNull": "error",
				"noForIn": "error",
				"noUnusedExpressions": "error",
				"noNestedPromises": "error",
				"noLoopFunc": "error",
				"noDrizzleDeleteWithoutWhere": "error",
				"noDrizzleUpdateWithoutWhere": "error",
				"noEmptyObjectKeys": "error",
				"noIdenticalTestTitle": "error"
			},
			"nursery": {
				"noFloatingPromises": "off",
				"noMisusedPromises": "off",
				"useAwaitThenable": "off",
				"noUnsafeTypeAssertion": "off",
				"noUselessTypeConversion": "error",
				"noUnsafePlusOperands": "off",
				"noBaseToString": "off",
				"noMisleadingReturnType": "error",
				"noImpliedEval": "error",
				"noExtendNative": "error",
				"noUnmodifiedLoopCondition": "error",
				"useExhaustiveSwitchCases": "error",
				"useIncludes": "error",
				"noThisOutsideOfClass": "error",
				"noNegationInEqualityCheck": "error",
				"noReturnInFinally": "error",
				"useStringStartsEndsWith": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/api/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/repositories/**", "@/workers/**", "@/integrations/**"],
										"message": "The HTTP layer talks to services. Put the read, the job enqueue or the framework call behind the service that owns it."
									},
									{
										"group": ["drizzle-orm", "drizzle-orm/**"],
										"message": "Queries live in src/repositories (and the query building blocks in src/integrations/drizzle-orm)."
									},
									{
										"group": ["better-auth", "better-auth/**", "@better-auth/**"],
										"message": "Better Auth stays behind src/integrations/better-auth. Call betterAuthApi or the auth services."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/services/**", "src/modules/**", "src/workers/**", "src/system/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/api/**"],
										"message": "Nothing calls the HTTP layer. src/api calls services, not the other way round."
									},
									{
										"group": ["elysia", "elysia/**"],
										"message": "Elysia lives in the HTTP layer (src/api). Other code takes plain data."
									},
									{
										"group": ["drizzle-orm", "drizzle-orm/**"],
										"message": "Queries live in src/repositories (and the query building blocks in src/integrations/drizzle-orm)."
									},
									{
										"group": ["better-auth", "better-auth/**", "@better-auth/**"],
										"message": "Better Auth stays behind src/integrations/better-auth. Call betterAuthApi or the auth services."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/plugins/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/api/**"],
										"message": "Nothing calls the HTTP layer. src/api calls services, not the other way round."
									},
									{
										"group": ["@/repositories/**", "@/integrations/drizzle-orm/database.*"],
										"message": "Plugins reach data through services, so every plugin write passes the same checks and hooks as a core write."
									},
									{
										"group": ["elysia", "elysia/**"],
										"message": "Elysia lives in the HTTP layer (src/api). Other code takes plain data."
									},
									{
										"group": ["drizzle-orm", "drizzle-orm/**"],
										"message": "Queries live in src/repositories (and the query building blocks in src/integrations/drizzle-orm)."
									},
									{
										"group": ["better-auth", "better-auth/**", "@better-auth/**"],
										"message": "Better Auth stays behind src/integrations/better-auth. Call betterAuthApi or the auth services."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/repositories/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/api/**", "@/services/**", "@/modules/**", "@/plugins/**", "@/workers/**", "@/system/**"],
										"message": "Repositories are the data layer: they know no use case, engine, worker or request."
									},
									{
										"group": ["elysia", "elysia/**"],
										"message": "Elysia lives in the HTTP layer (src/api). Other code takes plain data."
									},
									{
										"group": ["better-auth", "better-auth/**", "@better-auth/**"],
										"message": "Better Auth stays behind src/integrations/better-auth. Call betterAuthApi or the auth services."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/integrations/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/api/**",
											"@/services/**",
											"@/repositories/**",
											"@/modules/**",
											"@/plugins/**",
											"@/workers/**",
											"@/system/**"
										],
										"message": "Integrations wrap external processes and services. They know nothing of the application above them."
									},
									{
										"group": ["elysia", "elysia/**"],
										"message": "Elysia lives in the HTTP layer (src/api). Other code takes plain data."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/config/**", "src/utils/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/api/**",
											"@/services/**",
											"@/repositories/**",
											"@/modules/**",
											"@/plugins/**",
											"@/workers/**",
											"@/system/**",
											"@/integrations/**"
										],
										"message": "config and utils are leaves: they depend on each other only."
									},
									{
										"group": ["elysia", "elysia/**"],
										"message": "Elysia lives in the HTTP layer (src/api). Other code takes plain data."
									},
									{
										"group": ["drizzle-orm", "drizzle-orm/**"],
										"message": "Queries live in src/repositories (and the query building blocks in src/integrations/drizzle-orm)."
									},
									{
										"group": ["better-auth", "better-auth/**", "@better-auth/**"],
										"message": "Better Auth stays behind src/integrations/better-auth. Call betterAuthApi or the auth services."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/**", "!**/*.test.ts", "!**/*.spec.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": {
							"level": "error",
							"options": {
								"allow": ["warn", "error"]
							}
						}
					},
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 500,
								"skipBlankLines": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"nursery": {
						"noUnsafeTypeAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.ts", "**/*.config.js"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["src/integrations/drizzle-orm/database.schema.ts"],
			"linter": {
				"rules": {
					"performance": {
						"noNamespaceImport": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/benchkit/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"performance": {
						"noReExportAll": "off",
						"noBarrelFile": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
