NODE_ENV=production # "development", "production", "test"

# All values below are optional — defaults apply when unset.
# APP_PORT defaults to 3030, ROOT_DIR to ./data, and BETTER_AUTH_SECRET
# is generated on first boot and persisted to $ROOT_DIR/secrets.env (chmod 600).

APP_PORT=3030
# Production defaults to localhost. Set to 0.0.0.0 when the server must be reachable over the LAN.
APP_HOST=127.0.0.1
APP_PUBLIC_URL="http://localhost:3000"
# Optional extra allowed origins / patterns (comma-separated).
# localhost, 127.0.0.1, private LAN ranges (192.168.x.x, 10.x.x.x, 172.16-31.x.x) and .lan/.local
# domains are always allowed. Add e.g. VPN/Tailscale or public domains here:
# http://*.ts:*,https://example.com
APP_ALLOWED_ORIGINS=""
APP_SECURE=false
APP_COOKIE_DOMAIN=""
# How many reverse proxies sit in front of the server and are trusted for X-Forwarded-For.
# 0 = header ignored (client address = TCP peer), 1 = single nginx/Caddy/Traefik, 2 = CDN + local proxy.
APP_TRUSTED_PROXY_COUNT=0
# Interactive API documentation at /openapi (true/false).
OPENAPI_DOCS_ENABLED=true

# Server data root: SQLite database, transcodes, downloads, plugins, images, secrets.env.
ROOT_DIR="./data"
DB_FILE_NAME=reelvault.sqlite
# Directory with the built web UI. Unset = `./web` next to the working directory
# when present (release archives ship this layout); otherwise API-only.
# APP_WEB_DIST=/opt/reelvault/web

# Absolute paths to the ffmpeg/ffprobe binaries. Fallback only: a path saved in
# the admin UI always wins, and when unset the bare command is resolved through
# PATH. The "-full" release archives bundle the binaries; start.sh/start.bat
# point these at them automatically.
# APP_FFMPEG_PATH=/opt/reelvault/bin/ffmpeg
# APP_FFPROBE_PATH=/opt/reelvault/bin/ffprobe

# First-run setup credential (true/false). Disabled by default: the setup wizard
# creates the administrator without a token — fine for a home/LAN install.
# Enable BEFORE exposing a not-yet-set-up server to an untrusted network;
# SETUP_TOKEN is then generated on first boot, persisted to secrets.env and printed to the log.
SETUP_TOKEN_ENABLED=false
# Explicit setup token override (only used when SETUP_TOKEN_ENABLED=true, min 16 chars).
SETUP_TOKEN=
# Auth/session secret. Set it explicitly to keep control, or let the server generate and persist it.
BETTER_AUTH_SECRET=

# ── Load-test / soak escape hatches — leave unset in production. ──
# Ceiling on the per-IP global request limiter (default 1000/min).
# REELVAULT_RATE_LIMIT_GLOBAL_MAX=1000000
# Multiplier applied to every per-route rate limit (default 1 = limits verbatim).
# REELVAULT_RATE_LIMIT_ROUTE_MULTIPLIER=100000
# Disables better-auth's internal limiter (it keys on the socket IP, which a
# load test cannot spread across identities).
# REELVAULT_AUTH_RATE_LIMIT_ENABLED=false
# Per-account login throttle ceiling, attempts per 5 minutes (default 10).
# REELVAULT_LOGIN_ACCOUNT_MAX_ATTEMPTS=10000000
