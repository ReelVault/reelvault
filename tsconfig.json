{
	"compilerOptions": {
		/* --- ENVIRONMENT & LANGUAGE --- */
		"target": "esnext",
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"allowJs": false,

		/* --- MODULES & RESOLUTION --- */
		"module": "preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"],
			"benchkit": ["./packages/benchkit/src/index.ts"]
		},

		/* --- INTEROP & CONSTRAINTS --- */
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,

		/* --- EMIT / CODE GENERATION --- */
		"rootDir": ".",
		"outDir": "./dist",
		"noEmit": true,
		"incremental": true,
		"preserveConstEnums": true,

		/* --- TYPE CHECKING --- */
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,

		// A missing property must not be confused with an explicitly undefined one —
		// DTO mappers and settings codecs rely on that distinction.
		"exactOptionalPropertyTypes": true,

		// Biome correctness/noUnusedVariables + noUnusedFunctionParameters already
		// cover this — leave off here to avoid two tools disagreeing on one file.
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["**/*.ts", "package.json"],
	"exclude": ["node_modules", "dist", "sdk/dist"]
}
