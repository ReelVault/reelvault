{
	"name": "reelvault-sdk",
	"version": "1.0.0",
	"description": "Typed SDK for ReelVault — HTTP client, shared contracts, plugin host and UI kit.",
	"license": "GPL-3.0-only",
	"type": "module",
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./client": {
			"import": {
				"types": "./dist/client/index.d.mts",
				"default": "./dist/client/index.mjs"
			},
			"require": {
				"types": "./dist/client/index.d.cts",
				"default": "./dist/client/index.cjs"
			}
		},
		"./common": {
			"import": {
				"types": "./dist/common/index.d.mts",
				"default": "./dist/common/index.mjs"
			},
			"require": {
				"types": "./dist/common/index.d.cts",
				"default": "./dist/common/index.cjs"
			}
		},
		"./plugin": {
			"import": {
				"types": "./dist/plugin/index.d.mts",
				"default": "./dist/plugin/index.mjs"
			},
			"require": {
				"types": "./dist/plugin/index.d.cts",
				"default": "./dist/plugin/index.cjs"
			}
		},
		"./ui": {
			"import": {
				"types": "./dist/ui/index.d.mts",
				"default": "./dist/ui/index.mjs"
			},
			"require": {
				"types": "./dist/ui/index.d.cts",
				"default": "./dist/ui/index.cjs"
			}
		},
		"./ui/schema": {
			"import": {
				"types": "./dist/ui/schema.d.mts",
				"default": "./dist/ui/schema.mjs"
			},
			"require": {
				"types": "./dist/ui/schema.d.cts",
				"default": "./dist/ui/schema.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing/index.d.mts",
				"default": "./dist/testing/index.mjs"
			},
			"require": {
				"types": "./dist/testing/index.d.cts",
				"default": "./dist/testing/index.cjs"
			}
		}
	},
	"scripts": {
		"prepack": "cd .. && bun run build-sdk && cp LICENSE sdk/LICENSE"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52",
		"elysia": "^1.4.30"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ReelVault/ReelVault.Server.git",
		"directory": "sdk"
	},
	"homepage": "https://reelvault.org/sdk/",
	"bugs": {
		"url": "https://github.com/ReelVault/ReelVault.Server/issues"
	},
	"keywords": [
		"reelvault",
		"media-server",
		"sdk",
		"client",
		"plugin",
		"elysia",
		"typebox"
	],
	"author": "ReelVault",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
