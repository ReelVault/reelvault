{
	"name": "reelvault-server",
	"version": "1.3.3",
	"description": "ReelVault Media Server",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"format": "biome check --write",
		"lint": "bun scripts/lint/lint.script.ts",
		"test": "bun test --parallel",
		"coverage": "bun scripts/coverage-check.script.ts",
		"mutation": "bun scripts/mutation-test.script.ts",
		"benchmark": "bun scripts/benchmark.script.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun scripts/seed.script.ts",
		"db:migrate": "bun scripts/admin/database.script.ts migrate",
		"db:check": "bun scripts/admin/database.script.ts check",
		"db:vacuum": "bun scripts/admin/database.script.ts vacuum",
		"db:backup": "bun scripts/admin/database.script.ts backup",
		"doctor": "bun scripts/admin/doctor.script.ts",
		"admin:reset-password": "bun scripts/admin/reset-password.script.ts",
		"admin:two-factor-enforcement": "bun scripts/admin/two-factor-enforcement.script.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.12",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@reelvault/sdk": "^1.3.0",
		"@sinclair/typebox": "^0.34.52",
		"better-auth": "1.7.12",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"elysia": "^1.4.30",
		"fast-xml-builder": "^1.3.1",
		"fast-xml-parser": "^5.11.2",
		"fast-xml-validator": "^1.4.2",
		"fflate": "^0.8.3",
		"pino": "^10.4.0",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "^1.4.3",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"jscpd": "5.4.2",
		"knip": "^6.42.1",
		"lefthook": "^2.2.2",
		"oxc-parser": "^0.154.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"pino-pretty": "^13.2.0",
		"typescript": "^7.0.2"
	}
}
