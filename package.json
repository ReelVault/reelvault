{
	"name": "reelvault-server",
	"version": "1.0.0",
	"description": "ReelVault Media Server",
	"type": "module",
	"private": true,
	"engines": {
		"bun": ">=1.4.2"
	},
	"scripts": {
		"----RUN": "",
		"dev": "bun --watch src/index.ts",
		"start": "bun run src/index.ts",
		"----SCRIPTS": "",
		"benchmark": "bun run scripts/benchmark.ts",
		"scenarios": "bun run scripts/scenarios.ts",
		"benchmark:http": "bun run scripts/benchmarks/http.bench.ts",
		"benchmark:streaming": "bun run scripts/benchmarks/streaming.bench.ts",
		"benchmark:upload": "bun run scripts/benchmarks/upload.bench.ts",
		"check-memory": "bun run scripts/memory-check.ts",
		"----DATABASE": "",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:migrate:runtime": "bun run scripts/migrate.ts",
		"db:push": "bunx --bun drizzle-kit push",
		"db:studio": "bunx --bun drizzle-kit studio",
		"db:seed": "bun run src/database/seeds.ts",
		"----CHECK": "",
		"format": "biome format --write && eslint --fix",
		"lint": "bun run lint:biome && bun run lint:oxlint",
		"lint:biome": "biome check --write",
		"lint:oxlint": "oxlint --type-aware",
		"deadcode": "knip-bun --config ./knip.json",
		"check-types": "tsc --noEmit --pretty",
		"test": "bun test",
		"----MISC": "",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.5",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@elysiajs/server-timing": "^1.4.1",
		"@reelvault/sdk": "^1.0.1",
		"@sinclair/typebox": "^0.34.52",
		"better-auth": "1.7.5",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"elysia": "^1.4.30",
		"fast-xml-builder": "^1.3.1",
		"fast-xml-parser": "^5.11.1",
		"fast-xml-validator": "^1.4.2",
		"fflate": "^0.8.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"sharp": "^0.35.4",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"@typescript-eslint/parser": "^8.70.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"drizzle-typebox": "^0.3.3",
		"eslint": "^10.11.0",
		"knip": "^6.38.0",
		"lefthook": "^2.1.14",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
